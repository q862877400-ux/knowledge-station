                        $('#formItsLogout').attr('action', itsLogoutUrl);
                        $('#btnSubmitItsLogout').click();
                    }
                }
            });

            $.ajax({
                type: 'post',
                url: '/usercenter/login/out',
                dataType: 'json',
                success: function (res) {
