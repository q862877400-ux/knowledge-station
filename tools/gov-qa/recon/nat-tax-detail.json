            success: function (res) {
                if('0' == res.code){
                }else{
                	if(res.data.yhdzsf){
		                // if(localStorage.getItem('city')==null){
		                if($.cookie('city')==null){
	                        code = res.data.yhdzsf;
	                        city = province[code];
		                }
                    }
                }
                $("#selected_city").text(city).data("code",code);
                // localStorage.setItem("city",code+","+city);
                $.cookie('city',code+","+city,{ path: '/'});
                //选择省市后回调事件共各页面完善各自业务需求
                var callback = $.evalFunction('checkCitycallback');
                if (callback) {
                    callback.call(this, code,city);
                }
            }
        })

    }

    function getCount(){
        $.ajax({
            type:'post',
            url:'/usercenter/index/getCount',
            success:function(res){
                var json = $.json(res).json;
                if(json){
                    var msg = $.json(json.personmsg);
                    if(msg) {
                        var collection = msg.collectioncount,
                            partnets = msg.partnets,
                            message = msg.totalMsg;
                        if (collection != 0&&collection!=null) {
                            if(collection>100){
                                collection = '99+';
                            }
                            $("#collection").empty().append('我的收藏<span class="num-box">' + collection + '</span>');
                        }
                        if (partnets != 0&&partnets!=null) {
                            if(partnets>100){
                                partnets = '99+';
                            }
                            $("#partnets").empty().append('好友申请<span class="num-box">' + partnets + '</span>');
                        }
                        if (message != 0&&message!=null) {
                            if(message>100){
                                message = '99+';
                            }
                            $("#message").empty().append('我的消息<span class="num-box">' + message + '</span>');
                        }
                    }
                }
            }
        });
    }

    function openpersonpage(tabId){
        var $form = $("<form action='/usercenter/personal/main' method='post' target='_blank'><input type='hidden' name='tabId' value='"+tabId+"'></form>");
        $("body").append($form);
        $form.submit();
        $form.remove();
    }

</script>
