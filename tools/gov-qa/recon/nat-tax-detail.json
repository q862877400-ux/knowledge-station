            callback: function (res) {
                if (res.code === 0) {
                    $.info(res.msg);
                } else {
                    $.correct("点赞成功");
                    countThumbsUp();
                    $('#likeBtn').addClass("on");
                    $('#likeBtn').removeAttr("onclick");
                    setTimeout(function () {
                        $('.upzan').fadeOut();
                    }, 500);

                    try {
                        // 添加网上留言点赞日志埋点
                        $.loadLogScript("https://12366.chinatax.gov.cn/znzx/js/arlog.js?time=" + new Date().getTime(), "arlogAnchor", {
                            "data-module": "wsly_dz",
                            "data-id": "9ece2b2640c5496cb30e9f4853ad1603",
                            "data-tag": "",
                            "data-title": ""
                        });
                    } catch (e) {
                    }
                }
            }
        })
    }

    //获取点赞数量
    function countThumbsUp() {
        $.ajax({
            type: 'post',
            url: '/nsrxt/thumbsup/getCount',
            data: {ywid: bh},
            dataType: 'json',
            success: function (res) {
                if (res.code === 0) {
                    return;
                }

                var _html = res.data;
                $('#likeNum').empty().append(_html);

            }
        })
    }

    //检查点赞状态
    function checkThumbsUp() {
        $.ajax({
            type: 'post',
            url: '/nsrxt/thumbsup/check',
            data: {ywid: bh},
            dataType: 'json',
            success: function (result) {
                if (result.code === 1) {
                    $('#likeBtn').addClass("on");
                    $('#likeBtn').removeAttr("onclick");
                    $('.upzan').hide();
                } else {
                    $('#likeBtn').removeClass("on");
                }
            }
        })
    }

    //检查收藏状态
    function checkCollection() {
        $.ajax({
            type: 'post',
            url: '/usercenter/userCollection/check',
            data: {ywid: bh},
            dataType: 'json',
            success: function (result) {
                if (result.code === 1) {
                    $('#collectionBtn').addClass('on');
                    $('#collectionBtn').removeAttr("onclick");
                    $('#collectionWord').html('已收藏');
                } else {
                    $('#collectionBtn').removeClass('on');
                    $('#collectionWord').html('收藏');
                }
            }
        })
    }

    //收藏留言详情
    function collect() {
        var bt = $('h1').text();

        var url = document.location.href;
        var ctx = '';
        var link = url.substring(url.indexOf(ctx) + ctx.length, url.length);

        $.ajaxPost({
            type: 'post',
            url: '/usercenter/userCollection/save',
            data: {lmbh: 'wsly', lmmc: '网上留言', scbt: bt, sclink: link, ywid: bh},
            dataType: 'json',
            callback: function (res) {
                if (res.code === 1) {
                    $('#collectionBtn').addClass('on');
                    $('#collectionWord').html('已收藏');
                    $('#collectionBtn').removeAttr("onclick");
                    $.correct("收藏成功");

                    try {
                        // 添加网上留言收藏日志埋点
                        $.loadLogScript("https://12366.chinatax.gov.cn/znzx/js/arlog.js?time=" + new Date().getTime(), "arlogAnchor", {
                            "data-module": "wsly_sc",
                            "data-id": "9ece2b2640c5496cb30e9f4853ad1603",
                            "data-tag": "",
                            "data-title": ""
                        });
                    } catch (e) {
                    }
                } else if (res.msg === 'collected') {
                    $('#collectionBtn').removeAttr("onclick");
                    $.info("您已收藏该信息，无法重复收藏");
                } else if (res.msg === 'excess') {
                    $.info("收藏数量过多，请删除收藏后重试");
                } else {
                    $.error("收藏失败，请稍后再试");
                }
            }
        })
    }

</script>
</body>
</html>

