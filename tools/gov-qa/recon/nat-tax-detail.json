<script type="text/javascript">
    var shareComponents = {
        share2Channel: function (type, title, url, toShare) {
            if (!toShare) {
                toShare = document.location.href;
            }

            switch (type) {
                case '1':
                    shareComponents.share2Wb(title, url, toShare);
                    break;
                case '2':
                    shareComponents.share2QZone(title, url, toShare);
                    break;
                case '3':
                    shareComponents.share2Wx(title, url, toShare);
                    break;
            }
        },

        share2Wb: function (title, localUrl, toShare) {
            var page_name = '国家税务总局12366纳税服务平台';
            var pic = localUrl + "/core-plugins/12366/css/images/logo-sml.png";

            var shareUrl = "http://service.weibo.com/share/share.php?";

            shareUrl = shareUrl + "url=" + encodeURIComponent(toShare);
            shareUrl = shareUrl + "&title=" + encodeURIComponent(page_name + "  " + title);
            shareUrl = shareUrl + "&pic=" + encodeURIComponent(pic);
            shareUrl = shareUrl + "&ralateUid=5120551209";
            shareUrl = shareUrl + "&language=zh_cn";
            window.open(shareUrl, "分享到微博", "height=600,width=900,location=yes,menubar=1");
        },

        share2QZone: function (title, localUrl, toShare) {
            var page_name = '国家税务总局12366纳税服务平台';
            var pic = localUrl + "/core-plugins/12366/css/images/logo-sml.png";

            var shareUrl = "http://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?";
            shareUrl = shareUrl + "url=" + encodeURIComponent(toShare);
            shareUrl = shareUrl + "&title=" + encodeURIComponent(title);
            shareUrl = shareUrl + "&pics=" + encodeURIComponent(pic);
            shareUrl = shareUrl + "&site=" + encodeURIComponent(page_name);
            shareUrl = shareUrl + "&summary=" + encodeURIComponent(page_name + "  " + title);
            window.open(shareUrl, "分享到QQ空间", "height=600,width=900,location=yes,menubar=1");
        },

        share2Wx: function (title, localUrl, toShare) {
            if (!$('#wx-share-code').qrcode) {
                shareComponents.loadScript('/core-plugins/12366/js/jquery.qrcode.min.js', shareComponents.wxCallbackFunction, toShare);
            } else {
                shareComponents.wxCallbackFunction(toShare)
            }

            $("#wx-share").show();
        },

        wxCallbackFunction: function (toShare) {
            $('#wx-share-code').empty();
            $('#wx-share-code').qrcode({
                text: toShare,//二维码链接地址
                height: 178,
                width: 178,
            })
        },

        loadScript: function (src, callback, toShare) {
            var script = document.createElement('script'),
                head = document.getElementsByTagName('head')[0];
            script.type = 'text/javascript';
            script.charset = 'UTF-8';
            script.src = src;
            if (script.addEventListener) {
                script.addEventListener('load', function () {
                    callback(toShare);
                }, false);
            } else if (script.attachEvent) {
                script.attachEvent('onreadystatechange', function () {
                    var target = window.event.srcElement;
                    if (target.readyState == 'loaded') {
                        callback(toShare);
                    }
                });
            }
            head.appendChild(script);
        },

        colseWxShare: function () {
            $("#wx-share").hide();
        }
    }
</script>
