ayui-btn dzcxDBtn\" lay-submit=\"\" lay-filter=\"form_ESiIBh\">查询</button>\n                <button type=\"reset\" class=\"layui-btn layui-btn-primary\" onclick=\"handleQuery('form_ESiIBh_514752', {field: {}})\">重置</button>\n            </div>\n          </form>\n\t\t<div class=\"bt-clear\"></div>\n\t\t<div class=\"page-content questionList-wrapper\">\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t<div class=\"questionList-item\">\n\t\t\t\t<p class=\"question-title\"><i class=\"iconfont icon-message\"></i></p>\n\t\t\t\t<p><p style=\"text-indent: 2em; text-align: justify;\">领导专家您好；关于《住房城乡建设部办公厅关于实施《危险性较大的分部分项工程安全管理规定》有关问题的通知》附件1和附件2:三、一）起重吊装及起重机械安装拆卸工程，采用非常规起重设备、方法，且单件起吊重量在100kN及以上的起重吊装工程。以及一）采用非常规起重设备、方法，且单件起吊重量在100kN及以上的起重吊装工程。这两条中采用非常规起重设备、方法，有两个疑问：1、非常规起重设备可具体到什么设备，是特种设备，还是其他机械？2、非常规起重方法是否包含双机抬吊，卷扬机反滑轮等不是单机吊装的方法？请问是否有相关文件界定范围，或者这个非常规是指何定义，请领导解惑，感谢。</p></p>\n\t\t\t\t<p></p>\n\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t<p class=\"info-user\">网友（吉林省吉林市 赵凌佐）</p>\n\t\t\t\t\t<span class=\"info-date\">\n                      2026-04-18\n                  </span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"answer-box\">\n\t\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t\t<p class=\"answer\">回复：</p>\n\t\t\t\t\t\t<span class=\"info-date answer-date\" style=\"right: 0;\">2026-05-27</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<p style=\"text-indent: 2em;\">该问题与2023年4月4日网友（山东省滕州市 刘来志）咨询内容相似，建议参照我部2023年4月11日政务咨询答复。</p>\n                  \t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t<div class=\"questionList-item\">\n\t\t\t\t<p class=\"question-title\"><i class=\"iconfont icon-message\"></i></p>\n\t\t\t\t<p><p style=\"text-indent: 2em; text-align: justify;\">在日常工作中，对于“非常规起重设备、方法吊装方法”单件起重量在100kN及以上中的作业需要专家论证，但非常规设备、方法是指哪些设备，哪些方法没有明确，请予以解读一下，谢谢。</p></p>\n\t\t\t\t<p></p>\n\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t<p class=\"info-user\">网友（江西省南昌市 胡凯）</p>\n\t\t\t\t\t<span class=\"info-date\">\n                      2026-04-18\n                  </span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"answer-box\">\n\t\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t\t<p class=\"answer\">回复：</p>\n\t\t\t\t\t\t<span class=\"info-date answer-date\" style=\"right: 0;\">2026-05-27</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<p style=\"text-indent: 2em; text-align: justify;\">该问题与2023年4月4日网友（山东省滕州市 刘来志）咨询内容相似，建议参照我部2023年4月11日政务咨询答复。</p>\n                  \t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t<div class=\"questionList-item\">\n\t\t\t\t<p class=\"question-title\"><i class=\"iconfont icon-message\"></i></p>\n\t\t\t\t<p><p style=\"text-indent: 2em; text-align: justify;\">领导好，《房屋市政工程生产安全重大事故隐患判定标准（2024版）》第八条第五款所述的建筑起重机械主要受力构件，在建筑起重机械相关的标准规范中都没有明确主要受力构件是哪些部位，请问建筑起重机械中的塔式起重机、施工升降机、履带起重机主要受力构件具体指的是什么部位？</p></p>\n\t\t\t\t<p></p>\n\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t<p class=\"info-user\">网友（广东省广州市 徐雅蒙）</p>\n\t\t\t\t\t<span class=\"info-date\">\n                      2026-04-17\n                  </span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"answer-box\">\n\t\t\t\t\t<div class=\"question-info\">\n\t\t\t\t\t\t<p class=\"answer\">回复：</p>\n\t\t\t\t\t\t<span class=\"info-date answer-date\" style=\"right: 0;\">2026-05-26</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<p style=\"text-indent: 2em;\">该问题与2026年1月22日网友（新疆维吾尔自治区乌鲁木齐市沙依巴克区 梁继龙）咨询内容相似，建议参照我部2026年2月13日政务咨询答复。</p>\n                  \t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\n\t\t</div>\n\t\t<div id=\"form_ESiIBh_pagination\" queryData=\"{'rows':'3','count':'672','pageNo':'1'}\"></div>\n\t\t<script src=\"/cms_files/filemanager/1150240553/script/20241/AEF173CE543630BF1A86AB97E7785A71.js\" type=\"text/javascript\" charset=\"utf-8\"></script>\n\t\t<script>\n\t\tvar thisSettingFormId = 'form_ESiIBh_514752';\n\t\tvar isForwardToNewLink = !!'';\n\t\twindow['form_ESiIBh_forwardUrl'] = '';\n\t\t$(function () {\n\t\tdoLayPageRender('form_ESiIBh_514752', {webId:\"86ca573ec4df405db627fdc2493677f3\", pageId:\"QydOZ61q6LsvHnuSdeecT\", parseType:\"bulidstatic\", pageType:\"column\", tagId: \"内容列表\", t