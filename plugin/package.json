{
  "name": "ks-dsh-plugin",
  "version": "0.0.1",
  "description": "DSH (DeepSeek Harness) bridge plugin for the KnowledgeStation 法规国标强关联 RAG engine: lazily spawns the local Python engine and exposes its authenticated HTTP API as model tools (ks_ping / ks_resolve_clause / ks_answer) + P1c 可点击取证引用（host /ks/session 路由 + client ks:pdf tab）。",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "smoke:pdf-fit": "node scripts/smoke-pdf-fit.mjs",
    "smoke:pdf-panel": "node scripts/smoke-pdf-panel.mjs",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:guard": "node scripts/smoke-settings-guard.mjs",
    "smoke:tools": "node scripts/smoke-effect-tool.mjs",
    "smoke:chatmode": "node scripts/smoke-chatmode.mjs",
    "smoke:client-entry": "node scripts/smoke-client-entry.mjs",
    "smoke:ingest": "node scripts/smoke-ingest.mjs",
    "smoke:engine-guard": "node scripts/smoke-engine-guard.mjs",
    "smoke:docimage": "node scripts/smoke-docimage.mjs",
    "smoke:sanitize": "node scripts/smoke-sanitize.mjs",
    "smoke:trim": "node scripts/smoke-trim.mjs",
    "smoke:materials": "node scripts/smoke-materials-tool.mjs",
    "smoke:materials-routes": "node scripts/smoke-materials-routes.mjs",
    "smoke:collect": "node scripts/smoke-collect-tool.mjs",
    "verify:commands": "node scripts/run-verify-commands.mjs",
    "e2e:sidebar": "node scripts/e2e-sidebar-pdf.mjs",
    "smoke": "node scripts/smoke-pdf-fit.mjs && node scripts/smoke-pdf-panel.mjs && node scripts/smoke-settings.mjs && node scripts/smoke-settings-guard.mjs && node scripts/smoke-effect-tool.mjs && node scripts/smoke-chatmode.mjs && node scripts/smoke-ingest.mjs && node scripts/smoke-engine-guard.mjs && node scripts/smoke-client-entry.mjs && node scripts/smoke-docimage.mjs && node scripts/smoke-sanitize.mjs && node scripts/smoke-trim.mjs && node scripts/smoke-materials-tool.mjs && node scripts/smoke-materials-routes.mjs && node scripts/smoke-collect-tool.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "src",
    "client",
    "client.js",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  }
}
