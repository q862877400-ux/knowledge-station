<script type="text/javascript">
	nui.parse();
	var pagesize=10;
	var pageindex=0;
	var eventtype="1";
	var clztype="1";
	var keywords="DL/T";
	var madeunit="";
	var submadeunit="";
	var status="1";
	var starttime="";
	var endtime="";
	var clzids="";
	var property;
	var sort="desc";
	var releasetime=null;
	
	$(document).ready(function(){
		getPageList(pageindex);
		selectedClass("releasetimeclass","dateButtonDiv");
		selectedClass("selectStatus","stateButtonDiv");
		showOrhideClassDiv();
	});
	
	function showOrhideClassDiv(){
		var stateButtonDiv = $("#stateButtonDiv").html();
		var dateButtonDiv = $("#dateButtonDiv").html();
		var indexButtonDiv = $("#indexButtonDiv").html();
		if(stateButtonDiv != "" && stateButtonDiv != null || dateButtonDiv != "" && dateButtonDiv != null || indexButtonDiv != "" && indexButtonDiv != null){
			$("#selected").show();
		}else{
			$("#selected").hide();
		}
	}
	
	function selectReleasetime(time){
		releasetime = time;
		getPageList(pageindex);
	}
	
	function selectStatus(){
		getPageList(pageindex);
	}
	
	function selectedClass(buttonName,labelName){
		var label = "";
		var statusList = $("input[name='"+buttonName+"']:checked");
		for(var i=0;i<statusList.length;i++){
			label = label + $(statusList[i]).attr("labelValue");
			if(i != statusList.length - 1){
				label = label + "|";
			}
		}
		$("#"+labelName).html("");
		if(label != null && label != ""){
			var button = '<button type="button" class="btn btn-default btn-xs" title="移除" id="p7" onclick="deleteClass(\''+buttonName+'\',\''+labelName+'\')">';
			button = button + label;
			button = button + "&nbsp;";
			button = button + '<span style="color: red" class="glyphicon glyphicon-remove"></span>';
			button = button + "</button>";
			$("#"+labelName).html(button);
		}
		showOrhideClassDiv();
		getPageList(pageindex);
	}
	
	function radioSelected(rad){
		$("input[name='releasetimeclass']:checked").prop("checked",false);
		$(rad).find("input:radio").prop("checked",true);
		selectedClass("releasetimeclass","dateButtonDiv");
	}
	
	function deleteClass(buttonName,labelName){
		$("input[name='"+buttonName+"']").prop("checked",false);
		$("#"+labelName).html("");
		showOrhideClassDiv();
		getPageList(pageindex);
	}
	
	function deleteClass2(labelName){
		eventtype = null;
		$("#"+labelName).html("");
		showOrhideClassDiv();
		getPageList(pageindex);
	}
	
	function screenOrder(){
		$("div[name='screenOrder']").removeClass("screenOrderUp");
		$("div[name='screenOrder']").removeClass("screenOrderDown");
	}
	
	function order(div){
		screenOrder();
		var sortcol = $(div).attr("sortcol");
		if(property == sortcol){
			if(sort == "desc"){
				sort = "asc";
				$(div).addClass("screenOrderUp");
			}else{
				sort = "desc";
				$(div).addClass("screenOrderDown");
			}
		}else{
			sort="desc";
			$(div).addClass("screenOrderDown");
		}
		property = sortcol;
		getPageList(pageindex);
	}
	
	function getPageList(pageindex){
		var statusPage;
		var statusList = $("input:checkbox[name='selectStatus']:checked");
		var s = "";
		for(var i=0;i<statusList.length;i++){
			s = s + $(statusList[i]).val();
			if(i != statusList.length - 1){
				s = s + ",";
			}
		}
		statusPage = status;
		if(s != ""){
			statusPage = s;
		}
	
		var releasetimeclass = $("input:radio[name='releasetimeclass']:checked").val();
		var resultkeywords = $("#resultkeywords").val();
		
		pageindex=pageindex;
		
		if(eventtype != null){
			var label = "";
			label = eventtype==1?'强标':eventtype != "" ? '推标' : "";
			$("#indexButtonDiv").html("");
			if(label != null && label != ""){
				var button = '<button type="button" class="btn btn-default btn-xs" title="移除" id="p7" onclick="deleteClass2(\'indexButtonDiv\')">';
				button = button + label;
				button = button + "&nbsp;";
				button = button + '<span style="color: red" class="glyphicon glyphicon-remove"></span>';
				button = button + "</button>";
				$("#indexButtonDiv").html(button);
			}
			showOrhideClassDiv();
		}
		
		if((keywords == null || keywords == "") && (property == null || property == "")){
			order($("#releasetimeDiv"));
		}
		
		nui.ajax({
			url:"com.primeton.pub.query.getPageListForDB.biz.ext",
			type:"post",
			data:{
				entity:{
					eventtype:eventtype,
					clztype:clztype,
					keywords:keywords,
					madeunit:madeunit,
					submadeunit:submadeunit,
					status:statusPage,
					starttime:starttime,
					endtime:endtime,
					clzids:clzids,
					pagesize:pagesize,
					pagebegin:(pageindex*pagesize),
					property:property,
					sort:sort,
					releasetime:releasetime,
					releasetimeclass:releasetimeclass,
					resultkeywords:resultkeywords
				}
			},
			cache:false,
			contentType:"text/json",
			success:function (obj){
				//初始化分页统计
				$("span[id='pageInfo']").html("<a style='color: grey;'>每页显示</a>&nbsp;"+pagesize+"&nbsp;<a style='color: grey;'>条,共</a>&nbsp;"+obj.total+"&nbsp;<a style='color: grey;'>条标准</a> &nbsp;<a style='color: red;'>"+(pageindex+1)+"</a>&nbsp;/&nbsp;"+(Math.ceil(obj.total/pagesize)));
				$("#pageInfo_top").html("<a style='color: grey;'>每页显示</a>&nbsp;"+pagesize+"&nbsp;<a style='color: grey;'>条,共</a>&nbsp;"+obj.total+"&nbsp;<a style='color: grey;'>条标准</a> &nbsp;<a style='color: red;'>"+(pageindex+1)+"</a>&nbsp;/&nbsp;"+(Math.ceil(obj.total/pagesize)));
				//初始化翻页按钮
				var pages="";
				var firstindex=0;
				var lastindex=(obj.total%pagesize==0)?Math.floor(obj.total/pagesize)-1:Math.floor(obj.total/pagesize);
				var backindex=(pageindex-1)<firstindex?firstindex:(pageindex-1);
				var nextindex=(pageindex+1)>lastindex?lastindex:(pageindex+1);
				pages+="<span class='laypage_curr' style='background-color:#337ab7;cursor:pointer' onclick='getPageList("+firstindex+")'>首页</span>";
				pages+="<span class='laypage_curr' style='background-color:#337ab7;cursor:pointer' onclick='getPageList("+backindex+")'>上一页</span>";
				pages+="<span class='laypage_curr' style='background-color:#337ab7;cursor:pointer' onclick='getPageList("+nextindex+")'>下一页</span>";
				pages+="<span class='laypage_curr' style='background-color:#337ab7;cursor:pointer' onclick='getPageList("+lastindex+")'>末页</span>";
				$("div[id='pager']").html(pages);												
				//显示查询结果
				var pageHtml="";
				$("tbody[id='pageList']").html(pageHtml);
				if(obj.datas != null && obj.datas.length>0){
					var flagcid =-1;
					for(var i=0;i<obj.datas.length;i++){
						
						var temp=obj.datas[i];
						if(temp.CNNAME=='中华人民共和国标准化法'){
							pageHtml+="<tr>";
							pageHtml+="<td>"+1+"</td>";
							pageHtml+="<td style='text-align: left;'><a href='javascript:void(0)' onclick='showInfo(\""+temp.EVENTID+"\")'>"+(temp.STANDARDNUMBER==null?'':temp.STANDARDNUMBER)+"</a></td>";
							pageHtml+="<td>";
							if(temp.ADOPTION==1){
								pageHtml+="<span class='label label-warning' style='font-size:13px;'>采</span></td>";
							}
							pageHtml+="</td>";
							pageHtml+="<td class='mytxt' style='text-align:left;padding: 0 8px 0 8px;'><a href='javascript:void(0)' style='color: gray;' onclick='showInfo(\""+temp.EVENTID+"\")' title='"+temp.CNNAME+"'>"+temp.CNNAME+"</a><br><a href='javascript:void(0)' style='color: gray;' onclick='showInfo(\""+temp.EVENTID+"\")' title='"+temp.ENNAME+"'>"+temp.ENNAME+"</a></td>";
							if(temp.EVENTTYPE==1){
								pageHtml+="<td>"+('强标')+"</td>";
							}else if(temp.EVENTTYPE==2){
								pageHtml+="<td>"+('推标')+"</td>";
							}else if(temp.EVENTTYPE==3){
								pageHtml+="<td>"+('法律')+"</td>";
							}else{
								pageHtml+="<td>"+"</td>";
							}
							pageHtml+="<td><span class='text-success' style='font-size:13px;'>"+(temp.STATUS==0?'废止':temp.STATUS==1?'现行':'被替代')+"</span></td>";
							pageHtml+="<td>"+(temp.RTIME==null?'':temp.RTIME)+"</td>";
							pageHtml+="<td>"+(temp.ITIME==null?'':temp.ITIME)+"</td>";
							pageHtml+="<td><button class='btn btn-sm btn-default' onclick='showInfo(\""+temp.EVENTID+"\")'>查看详细</button></td>";
							pageHtml+="</tr>";
							$("tbody[id='pageList']").html(pageHtml);
							flagcid = i;
						}
					}
					for(var i=0;i<obj.datas.length;i++){
						var temp=obj.datas[i];
						if(temp.EVENTID!=null&&flagcid!=null&&flagcid!=i){
							pageHtml+="<tr>";
							if(flagcid>i){
								pageHtml+="<td>"+(i+2)+"</td>";
							}else{
								pageHtml+="<td>"+(i+1)+"</td>";
							}
							pageHtml+="<td style='text-align: left;'><a href='javascript:void(0)' onclick='showInfo(\""+temp.EVENTID+"\")'>"+(temp.STANDARDNUMBER==null?'':temp.STANDARDNUMBER)+"</a></td>";
							pageHtml+="<td>";
							if(temp.ADOPTION==1){
								pageHtml+="<span class='label label-warning' style='font-size:13px;'>采</span></td>";
							}
							pageHtml+="</td>";
							pageHtml+="<td class='mytxt' style='text-align:left;padding: 0 8px 0 8px;'><a href='javascript:void(0)' style='color: gray;' onclick='showInfo(\""+temp.EVENTID+"\")' title='"+temp.CNNAME+"'>"+temp.CNNAME+"</a><br><a href='javascript:void(0)' style='color: gray;' onclick='showInfo(\""+temp.EVENTID+"\")' title='"+temp.ENNAME+"'>"+temp.ENNAME+"</a></td>";
							if(temp.EVENTTYPE==1){
								pageHtml+="<td>"+('强标')+"</td>";
							}else if(temp.EVENTTYPE==2){
								pageHtml+="<td>"+('推标')+"</td>";
							}else if(temp.EVENTTYPE==3){
								pageHtml+="<td>"+('法律')+"</td>";
							}else{
								pageHtml+="<td>"+"</td>";
							}
							pageHtml+="<td><span class='text-success' style='font-size:13px;'>"+(temp.STATUS==0?'废止':temp.STATUS==1?'现行':'被替代')+"</span></td>";
							pageHtml+="<td>"+(temp.RTIME==null?'':temp.RTIME)+"</td>";
							pageHtml+="<td>"+(temp.ITIME==null?'':temp.ITIME)+"</td>";
							pageHtml+="<td><button class='btn btn-sm btn-default' onclick='showInfo(\""+temp.EVENTID+"\")'>查看详细</button></td>";
							pageHtml+="</tr>";
							$("tbody[id='pageList']").html(pageHtml);
						}
					}
				}
				if(obj.status != null && obj.status.length>0){
					for(var i=0;i<obj.status.length;i++){
						var temp=obj.status[i];
						if(temp.STATUS == 0){
							$("#statusFZ").html(temp.STACOUNT);
							if(temp.STACOUNT == 0 || temp.STACOUNT == null || temp.STACOUNT == ""){
								$("#statusFZ").parents("li[role='presentation']").hide();
							}else{
								$("#statusFZ").parents("li[role='presentation']").show();
							}
						}else if(temp.STATUS == 1){
							$("#statusXX").html(temp.STACOUNT);
							if(temp.STACOUNT == 0 || temp.STACOUNT == null || temp.STACOUNT == ""){
								$("#statusXX").parents("li[role='presentation']").hide();
							}else{
								$("#statusXX").parents("li[role='presentation']").show();
							}
						}else if(temp.STATUS == 2){
							$("#statusLJSS").html(temp.STACOUNT);
							if(temp.STACOUNT == 0 || temp.STACOUNT == null || temp.STACOUNT == ""){
								$("#statusLJSS").parents("li[role='presentation']").hide();
							}else{
								$("#statusLJSS").parents("li[role='presentation']").show();
							}
						}
					}
				}
				if(obj.datecount != null && obj.datecount.length>0){
					for(var i=0;i<obj.datecount.length;i++){
						var temp=obj.datecount[i];
						if(temp.YEARCLASS == 1){
							$("#releasetime3M").html(temp.TIMECOUNT);
							if(temp.TIMECOUNT == 0 || temp.TIMECOUNT == null || temp.TIMECOUNT == ""){
								$("#releasetime3M").parents("li[role='presentation']").hide();
							}else{
								$("#releasetime3M").parents("li[role='presentation']").show();
							}
						}else if(temp.YEARCLASS == 2){
							$("#releasetime1Y").html(temp.TIMECOUNT);
							if(temp.TIMECOUNT == 0 || temp.TIMECOUNT == null || temp.TIMECOUNT == ""){
								$("#releasetime1Y").parents("li[role='presentation']").hide();
							}else{
								$("#releasetime1Y").parents("li[role='presentation']").show();
							}
						}else if(temp.YEARCLASS == 3){
							$("#releasetime2Y").html(temp.TIMECOUNT);
							if(temp.TIMECOUNT == 0 || temp.TIMECOUNT == null || temp.TIMECOUNT == ""){
								$("#releasetime2Y").parents("li[role='presentation']").hide();
							}else{
								$("#releasetime2Y").parents("li[role='presentation']").show();
							}
						}else if(temp.YEARCLASS == 4){
							$("#releasetime3Y").html(temp.TIMECOUNT);
							if(temp.TIMECOUNT == 0 || temp.TIMECOUNT == null || temp.TIMECOUNT == ""){
								$("#releasetime3Y").parents("li[role='presentation']").hide();
							}else{
								$("#releasetime3Y").parents("li[role='presentation']").show();
							}
						}else if(temp.YEARCLASS == 5){
							$("#releasetime4Y").html(temp.TIMECOUNT);
							if(temp.TIMECOUNT == 0 || temp.TIMECOUNT == null || temp.TIMECOUNT == ""){
								$("#releasetime4Y").parents("li[role='presentation']").hide();
							}else{
								$("#releasetime4Y").parents("li[role='presentation']").show();
							}
						}
					}
				}
			}
		});
	}
	
	function showInfo(eventid){
		window.open("/default/pub/detail.jsp?eventid="+eventid);
	}
</script>
</html>